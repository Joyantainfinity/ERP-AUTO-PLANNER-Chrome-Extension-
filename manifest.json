{
  "manifest_version": 3,
  "name": "ERP AUTO PLANNER",
  "version": "3.0",
  "description": "Automatically selects planning sections (fully customizable list) and fills Actual/Payable Wages and Overhead Cost on the ERP Wages page — both in one click.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ERP AUTO PLANNER",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
